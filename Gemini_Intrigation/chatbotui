import { useState } from "react";
import { Send, MessageCircle, X } from "lucide-react";

const ChatBot = () => {
  const [isOpen, setIsOpen] = useState(false);
  const [messages, setMessages] = useState([]);
  const [input, setInput] = useState("");

  const toggleChat = () => {
    setIsOpen(!isOpen);
  };

  const sendMessage = () => {
    if (input.trim() !== "") {
      setMessages([...messages, { text: input, sender: "user" }]);
      setInput("");

      setTimeout(() => {
        setMessages((prev) => [...prev, { text: "I'm here to help!", sender: "bot" }]);
      }, 1000);
    }
  };
 
  return (
    <div className="fixed bottom-4 right-4 flex flex-col items-end">
      {isOpen && (
        <div className="w-80 bg-white shadow-lg rounded-xl overflow-hidden border border-gray-200 flex flex-col">
          {/* Header */}
          <div className="bg-gradient-to-r from-indigo-500 to-purple-500 text-white p-3 text-lg font-semibold flex justify-between items-center">
            <span>How can I help you?</span>
            <button onClick={toggleChat} className="text-white">
              <X size={20} />
            </button>
          </div>

          {/* Messages */}
          <div className="h-60 p-3 overflow-y-auto space-y-2 custom-scroll">
            {messages.map((msg, index) => (
              <div
                key={index}
                className={`p-2 max-w-[75%] break-words rounded-lg ${
                  msg.sender === "user"
                    ? "bg-blue-500 text-white self-end ml-auto"
                    : "bg-gray-200 text-gray-900"
                }`}
              >
                {msg.text}
              </div>
            ))}
          </div>

          {/* Input */}
          <div className="flex border-t border-gray-300 p-2">
            <input
              type="text"
              className="flex-1 p-2 border border-gray-300 rounded-l-lg focus:outline-none"
              placeholder="Type your message..."
              value={input}
              onChange={(e) => setInput(e.target.value)}
            />
            <button onClick={sendMessage} className="bg-indigo-500 text-white px-4 rounded-r-lg flex items-center justify-center">
              <Send size={20} />
            </button>
          </div>
        </div>
      )}
      
      {/* Chat Icon */}
      <button onClick={toggleChat} className="bg-indigo-500 text-white p-3 rounded-full shadow-lg hover:bg-indigo-600">
        <MessageCircle size={28} />
      </button>
    </div>
  );
};

export default ChatBot;
